# Local development only. Copy to .env before `docker compose up --build`.
# This repository is public. These values are placeholders, not secrets.
# Change every password before anyone else can reach the stack.
# The API refuses SUPER_ADMIN_PASSWORD when NODE_ENV=production or COOKIE_SECURE=true
# if it is still the placeholder below.

NODE_ENV=development
POSTGRES_DB=ushindi
POSTGRES_USER=ushindi
POSTGRES_PASSWORD=local_dev_only_change_me_1

# Browser origin for the Vue app. Comma-separate extra origins if needed.
CORS_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
TRUST_PROXY=true

# First super admin. The account is created on API startup when the password is set.
# Use a real Tanzanian mobile number you control before any shared deployment.
SUPER_ADMIN_PHONE=+255700000001
SUPER_ADMIN_PASSWORD=local_dev_only_change_me_1
SUPER_ADMIN_NAME=Ushindi Super Admin
SUPER_ADMIN_DOB=1990-01-01

# Whole shillings. The deposit page and POST /api/deposits both use these.
# Admin can change them later from /admin. Defaults are 30000 and 5000000.
MIN_DEPOSIT_TZS=30000
MAX_DEPOSIT_TZS=5000000
